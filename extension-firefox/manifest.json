{
  "manifest_version": 3,
  "name": "Nocturnal",
  "version": "0.7.0",
  "description": "Envie links, vídeos e áudios ao Nocturnal pelo menu do botão direito. Sem botão flutuante.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "background": {
    "scripts": [
      "shared.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Nocturnal — vídeos e arquivos",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fastget-local@example.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  }
}
